{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Neo",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#imports"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#directives"
    },
    {
      "include": "#builtin_compile_time"
    },
    {
      "include": "#generic_constraints"
    },
    {
      "include": "#platform_flags"
    },
    {
      "include": "#utility_macros"
    },
    {
      "include": "#macros"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#statements"
    },
    {
      "include": "#callables"
    },
    {
      "include": "#generic_params"
    },
    {
      "include": "#digits"
    },
    {
      "include": "#ident"
    }
  ],
  "repository": {
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.neo",
          "match": "\\b(if|else|elif|while|until|for|return|yields|when|fallthrough|break|continue|in|defer|defer_err|goto|try|push_context|unreachable)\\b"
        },
        {
          "name": "storage.modifier.neo",
          "match": "\\b(restrict|volatile)\\b"
        },
        {
          "name": "keyword.reserved.neo",
          "match": "\\b(impl|constimpl|endimpl|md|does|behavior)\\b"
        },
        {
          "comment": "Intrinsic keywords recognized by the lexer",
          "name": "keyword.intrinsics.neo",
          "match": "\\b(cast|recast|auto_cast|type_of|typename_of|typeid_of|typeinfo_of|size_of|align_of)\\b"
        },
        {
          "name": "keyword.operator.memory.neo",
          "match": "\\b(new|free)\\b"
        },
        {
          "name": "constant.language.null.neo",
          "match": "\\b(null|undefined)\\b"
        },
        {
          "name": "constant.language.boolean.neo",
          "match": "\\b(true|false)\\b"
        },
        {
          "comment": "Null-coalescing assignment",
          "match": "\\?\\?=",
          "name": "keyword.operator.assignment.null-coalescing.neo"
        },
        {
          "comment": "Logical-or assignment",
          "match": "\\|\\|=",
          "name": "keyword.operator.assignment.logical.neo"
        },
        {
          "comment": "Null coalescing",
          "match": "\\?\\?",
          "name": "keyword.operator.null-coalescing.neo"
        },
        {
          "comment": "Optional chaining",
          "match": "\\?\\.",
          "name": "keyword.operator.optional-chain.neo"
        },
        {
          "comment": "Optional unwrap",
          "match": "\\.\\?",
          "name": "keyword.operator.optional-unwrap.neo"
        },
        {
          "comment": "Force unwrap",
          "match": "\\.!",
          "name": "keyword.operator.optional-unwrap.force.neo"
        },
        {
          "comment": "Payload capturing / fat arrow",
          "match": "=>",
          "name": "keyword.operator.arrow.fat.neo"
        },
        {
          "comment": "Reverse-iteration / left arrow",
          "match": "<-",
          "name": "keyword.operator.arrow.left.neo"
        },
        {
          "comment": "Pointer field access",
          "match": "->",
          "name": "keyword.operator.arrow.neo"
        },
        {
          "comment": "Inclusive range",
          "match": "\\.\\.=",
          "name": "keyword.operator.range.inclusive.neo"
        },
        {
          "comment": "Half-open range",
          "match": "\\.\\.<",
          "name": "keyword.operator.range.half-open.neo"
        },
        {
          "comment": "Spread operator",
          "match": "\\.\\.\\.",
          "name": "keyword.operator.spread.neo"
        },
        {
          "comment": "Plain range",
          "match": "\\.\\.",
          "name": "keyword.operator.range.neo"
        },
        {
          "comment": "Compile-time concatenation operator",
          "match": "##",
          "name": "keyword.operator.concatenation.neo"
        },
        {
          "comment": "Label address operator",
          "match": "@@",
          "name": "keyword.operator.label.neo"
        },
        {
          "comment": "Saturating arithmetic operators",
          "match": "(@\\+\\+|@--|@<<=|@<<|@\\+=|@-=|@\\*=|@/=|@\\+|@-|@\\*|@/)",
          "name": "keyword.operator.arithmetic.saturating.neo"
        },
        {
          "comment": "Wrapping arithmetic operators",
          "match": "(%\\+\\+|%--|%\\+=|%-=|%\\*=|%/=|%\\+|%-|%\\*|%/)",
          "name": "keyword.operator.arithmetic.wrapping.neo"
        },
        {
          "comment": "Exponentiation",
          "match": "\\*\\*",
          "name": "keyword.operator.arithmetic.exponent.neo"
        },
        {
          "comment": "Bitwise / shift assignment",
          "match": "((&|\\||\\^|~|<<|>>)=)",
          "name": "keyword.operator.assignment.bitwise.neo"
        },
        {
          "comment": "Bitwise shift / not",
          "match": "(<<|>>|~)",
          "name": "keyword.operator.bitwise.shift.neo"
        },
        {
          "comment": "Comparison",
          "match": "(==|!=|<=|>=|<|>)",
          "name": "keyword.operator.comparison.neo"
        },
        {
          "comment": "Arithmetic assignment",
          "match": "([+\\*/%\\-]=)",
          "name": "keyword.operator.assignment.arithmetic.neo"
        },
        {
          "comment": "Assignment / declaration",
          "match": "(::=|:=|=)",
          "name": "keyword.operator.assignment.neo"
        },
        {
          "comment": "Increment / decrement",
          "match": "(\\-\\-|\\+\\+)",
          "name": "keyword.operator.increment-decrement.neo"
        },
        {
          "comment": "Arithmetic",
          "match": "(\\-|\\+|\\*|\\/|%)",
          "name": "keyword.operator.arithmetic.neo"
        },
        {
          "comment": "Logical",
          "match": "(!|&&|\\|\\|)",
          "name": "keyword.operator.logical.neo"
        },
        {
          "comment": "Bitwise",
          "match": "(\\||&)",
          "name": "keyword.operator.bitwise.neo"
        },
        {
          "match": "\\b(as|extern|api)\\b",
          "name": "keyword.other.use.neo"
        },
        {
          "name": "keyword.structure.neo",
          "match": "\\b(struct|enum|error|union)\\b"
        },
        {
          "match": "\\b(bool|b1|b8|b16|b32|b64|char|string|cstring|int|uint|uintptr|intptr|isize|usize|float|double|s8|s16|s32|s64|s128|u8|u16|u32|u64|u128|f16|f32|f64|f128|byte|void|typeid|unknown|rawptr|Result|Optional)\\b",
          "name": "storage.type.primitive.neo"
        },
        {
          "name": "keyword.other.included",
          "match": "\\b(assert|assert_db|panic)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "comment": "Built-in memory / container functions",
          "name": "support.function.builtin.neo",
          "match": "\\b(make|make_safe|delete|new_safe|new_undefined)\\b"
        }
      ]
    },
    "statements": {
      "patterns": [
        {
          "match": "\\b(mut|const)\\s+(\\^?[A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "keyword.default.neo"
            },
            "2": {
              "name": "support.variable.neo"
            }
          }
        },
        {
          "match": "\\b(fn)\\s+(([A-Za-z_][A-Za-z0-9_]*(::))?[A-Za-z_][A-Za-z0-9_]*)\\s*[\\(<\\[]",
          "captures": {
            "1": {
              "name": "keyword.default.neo"
            },
            "2": {
              "name": "entity.name.function.neo"
            },
            "3": {
              "name": "entity.name.type.type.neo"
            },
            "4": {
              "name": "punctuation.coloncolon"
            }
          }
        },
        {
          "comment": "fn name overloads { ... }",
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+(overloads)\\s*\\{",
          "captures": {
            "1": {
              "name": "keyword.default.neo"
            },
            "2": {
              "name": "entity.name.function.neo"
            },
            "3": {
              "name": "keyword.default.neo"
            }
          }
        },
        {
          "comment": "operator +/- etc. overloads { ... }",
          "match": "\\b(operator)\\s+(==|!=|\\+|-|\\*|/|\\+=|-=|\\*=|/=|\\[\\]|\\[\\]=|<|>|<=|>=|!|~)\\s+(overloads)\\s*\\{",
          "captures": {
            "1": {
              "name": "keyword.default.neo"
            },
            "2": {
              "name": "entity.name.function.operator.neo"
            },
            "3": {
              "name": "keyword.default.neo"
            }
          }
        },
        {
          "comment": "typedef X as Y or typedef X struct/enum/union/error { }",
          "match": "\\b(typedef)\\s+([A-Za-z_][A-Za-z0-9_]*)(?:\\s+(as)\\s+([A-Za-z_][A-Za-z0-9_|\\s]*))?\\b",
          "captures": {
            "1": {
              "name": "keyword.default.neo"
            },
            "2": {
              "name": "entity.name.type.type.neo"
            },
            "3": {
              "name": "storage.modifier.neo"
            },
            "4": {
              "name": "entity.name.type.type.neo"
            }
          }
        },
        {
          "match": "\\b(namespace)\\s+([A-Za-z_][A-Za-z0-9_]*)(?:\\s*(as)\\s*([A-Za-z_][A-Za-z0-9_]*))?\\b",
          "captures": {
            "1": {
              "name": "keyword.default.neo"
            },
            "2": {
              "name": "entity.name.type.module.neo"
            }
          }
        },
        {
          "match": "\\b(use|using)\\s+(('|\")?[A-Za-z_][A-Za-z0-9_:.]*('|\")?)(?:\\s*(as)\\s*([A-Za-z_][A-Za-z0-9_]*))?",
          "captures": {
            "1": {
              "name": "keyword.default.neo"
            },
            "2": {
              "name": "entity.name.type.module.neo"
            }
          }
        },
        {
          "comment": "test \"name\" { or test skip",
          "match": "\\b(test)\\s+(\"[^\"]*\"|skip)\\b",
          "captures": {
            "1": {
              "name": "keyword.default.neo"
            },
            "2": {
              "name": "string.quoted.double.neo"
            }
          }
        },
        {
          "comment": "skip test",
          "match": "\\b(skip)\\s+(test)\\b",
          "captures": {
            "1": {
              "name": "keyword.default.neo"
            },
            "2": {
              "name": "keyword.default.neo"
            }
          }
        },
        {
          "comment": "test { (unnamed test block)",
          "match": "\\b(test)\\s*\\{",
          "captures": {
            "1": {
              "name": "keyword.default.neo"
            }
          }
        }
      ]
    },
    "imports": {
      "patterns": [
        {
          "comment": "#import extern \"header.h\" as name;",
          "match": "(#import)\\s+(extern)\\s+(\"[^\"]*\")\\s+(as)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.neo"
            },
            "2": {
              "name": "storage.modifier.neo"
            },
            "3": {
              "name": "string.quoted.double.neo"
            },
            "4": {
              "name": "keyword.control.neo"
            },
            "5": {
              "name": "entity.name.type.module.neo"
            }
          }
        },
        {
          "comment": "#import { ... } from name;",
          "match": "(#import)\\s+(\\{[^}]*\\})\\s+(from)\\s+([A-Za-z_][A-Za-z0-9_:]*)",
          "captures": {
            "1": {
              "name": "keyword.control.neo"
            },
            "2": {
              "name": "meta.import.list.neo"
            },
            "3": {
              "name": "keyword.control.neo"
            },
            "4": {
              "name": "entity.name.type.module.neo"
            }
          }
        },
        {
          "comment": "#import using name; or #import using \"name\";",
          "match": "(#import)\\s+(using)\\s+(\"[^\"]*\"|[A-Za-z_][A-Za-z0-9_:]*)",
          "captures": {
            "1": {
              "name": "keyword.control.neo"
            },
            "2": {
              "name": "keyword.control.neo"
            },
            "3": {
              "name": "entity.name.type.module.neo"
            }
          }
        },
        {
          "comment": "#import name as alias; or #import name using;",
          "match": "(#import)\\s+(\"[^\"]*\"|[A-Za-z_][A-Za-z0-9_:]*)\\s+(as|using)(?:\\s+([A-Za-z_][A-Za-z0-9_]*))?",
          "captures": {
            "1": {
              "name": "keyword.control.neo"
            },
            "2": {
              "name": "entity.name.type.module.neo"
            },
            "3": {
              "name": "keyword.control.neo"
            },
            "4": {
              "name": "entity.name.type.module.neo"
            }
          }
        },
        {
          "comment": "#import name; or #import \"name\";",
          "match": "(#import)\\s+(\"[^\"]*\"|[A-Za-z_][A-Za-z0-9_:]*)",
          "captures": {
            "1": {
              "name": "keyword.control.neo"
            },
            "2": {
              "name": "entity.name.type.module.neo"
            }
          }
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "comment": "#[...] attribute syntax",
          "begin": "#\\[",
          "end": "\\]",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.attribute.begin.neo"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.attribute.end.neo"
            }
          },
          "name": "meta.attribute.neo",
          "patterns": [
            {
              "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b",
              "name": "entity.other.attribute-name.neo"
            },
            {
              "include": "#strings"
            },
            {
              "include": "#digits"
            }
          ]
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "comment": "Compile-time directives (not #import, handled separately)",
          "match": "#(run|insert|code|macro|modify|bake_constants|specialize|define|undef|set|unset|if|elif|else|ifndef|for|error|warn|info|todo|assert|asm|soa|ordered|context_append)\\b",
          "name": "keyword.control.directive.neo"
        }
      ]
    },
    "builtin_compile_time": {
      "patterns": [
        {
          "comment": "Built-in compile-time values",
          "match": "#(file|path|line|column|function|namespace|location|caller_location|target_os|target_arch|target_endian|target_pointer_width|target_triple|build_mode|opt_level|neo_version|neo_version_major|neo_version_minor|neo_version_patch|build_time|build_date|build_timestamp|counter|iota)\\b",
          "name": "constant.language.builtin.neo"
        }
      ]
    },
    "generic_constraints": {
      "patterns": [
        {
          "comment": "Generic type constraints",
          "match": "#(number|integer|decimal|signed|signed_integer|unsigned|unsigned_integer|boolean)\\b",
          "name": "storage.type.constraint.neo"
        }
      ]
    },
    "platform_flags": {
      "patterns": [
        {
          "comment": "Platform detection flags",
          "match": "#(OS_WINDOWS|OS_LINUX|OS_MACOS|OS_IOS|OS_ANDROID|OS_FREEBSD|OS_OPENBSD|OS_NETBSD|OS_WASM|ARCH_X86|ARCH_X86_64|ARCH_ARM|ARCH_ARM64|ARCH_WASM32|ARCH_WASM64|ARCH_RISCV32|ARCH_RISCV64)\\b",
          "name": "constant.language.platform.neo"
        }
      ]
    },
    "utility_macros": {
      "patterns": [
        {
          "comment": "Utility compile-time macros",
          "match": "#(embed_bytes|embed_string|concat|stringify|c_varargs|env)\\b",
          "name": "support.function.macro.builtin.neo"
        }
      ]
    },
    "macros": {
      "patterns": [
        {
          "comment": "Fallback: any #identifier not matched above",
          "match": "#([A-Za-z_][A-Za-z0-9_]*)",
          "name": "support.function.macro.neo"
        }
      ]
    },
    "generic_params": {
      "patterns": [
        {
          "comment": "$T generic type parameters",
          "match": "\\$([A-Za-z_][A-Za-z0-9_]*)",
          "name": "entity.name.type.generic.neo"
        }
      ]
    },
    "callables": {
      "patterns": [
        {
          "match": "([A-Za-z_][A-Za-z0-9_]*)\\(",
          "captures": {
            "1": {
              "name": "support.function.neo"
            }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.neo",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.neo",
              "match": "(?x)\\\\ (\n\\\\\t\t\t |\n[abefnprtv'\"?]   |\n[0-3]\\d{,2}\t |\n[4-7]\\d?\t\t|\nx[a-fA-F0-9]{,2} |\nu[a-fA-F0-9]{,4} |\nU[a-fA-F0-9]{,8} )"
            }
          ]
        },
        {
          "name": "string.quoted.single.neo",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.neo",
              "match": "(?x)\\\\ (\n\\\\\t\t\t |\n[abefnprtv'\"?]   |\n[0-3]\\d{,2}\t |\n[4-7]\\d?\t\t|\nx[a-fA-F0-9]{,2} |\nu[a-fA-F0-9]{,4} |\nU[a-fA-F0-9]{,8} )"
            }
          ]
        },
        {
          "name": "string.quoted.raw.neo",
          "begin": "`",
          "end": "`"
        }
      ]
    },
    "digits": {
      "patterns": [
        {
          "comment": "Hexadecimal literal",
          "name": "constant.numeric.hex.neo",
          "match": "\\b0[xX][0-9a-fA-F_]+\\b"
        },
        {
          "comment": "Binary literal",
          "name": "constant.numeric.binary.neo",
          "match": "\\b0[bB][01_]+\\b"
        },
        {
          "comment": "Quaternary (base-4) literal",
          "name": "constant.numeric.quaternary.neo",
          "match": "\\b0[qQ][0-3_]+\\b"
        },
        {
          "comment": "Float literal with decimal point and optional exponent/suffix",
          "name": "constant.numeric.float.neo",
          "match": "\\b[0-9][0-9_]*\\.[0-9_]+([eE][+-]?[0-9_]+)?[fFdDhHqQ]?\\b"
        },
        {
          "comment": "Float literal with exponent (no decimal point)",
          "name": "constant.numeric.float.neo",
          "match": "\\b[0-9][0-9_]*[eE][+-]?[0-9_]+[fFdDhHqQ]?\\b"
        },
        {
          "comment": "Float literal with suffix only (e.g. 12f, 5h)",
          "name": "constant.numeric.float.neo",
          "match": "\\b[0-9][0-9_]*[fFdDhHqQ]\\b"
        },
        {
          "comment": "Integer literal",
          "name": "constant.numeric.integer.neo",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "ident": {
      "patterns": [
        {
          "name": "variable.other.readwrite.neo",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "begin": "/\\*\\*(?!/)",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.neo"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.neo"
            }
          },
          "name": "comment.block.documentation.neo",
          "patterns": [
            {
              "include": "#nested"
            }
          ]
        },
        {
          "begin": "/\\*:",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.neo"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.neo"
            }
          },
          "name": "comment.block.documentation.playground.neo",
          "patterns": [
            {
              "include": "#nested"
            }
          ]
        },
        {
          "begin": "/\\*|/-",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.neo"
            }
          },
          "end": "\\*/|-/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.neo"
            }
          },
          "name": "comment.block.neo",
          "patterns": [
            {
              "include": "#nested"
            }
          ]
        },
        {
          "match": "\\*/|-/",
          "name": "invalid.illegal.unexpected-end-of-block-comment.neo"
        },
        {
          "begin": "(^[ \\t]+)?(?=//)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.whitespace.comment.leading.neo"
            }
          },
          "end": "(?!\\G)",
          "patterns": [
            {
              "begin": "///",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.definition.comment.neo"
                }
              },
              "end": "^",
              "name": "comment.line.triple-slash.documentation.neo"
            },
            {
              "begin": "//:",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.definition.comment.neo"
                }
              },
              "end": "^",
              "name": "comment.line.double-slash.documentation.neo"
            },
            {
              "begin": "//",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.definition.comment.neo"
                }
              },
              "end": "^",
              "name": "comment.line.double-slash.neo"
            }
          ]
        }
      ],
      "repository": {
        "nested": {
          "begin": "/\\*|/-",
          "end": "\\*/|-/",
          "patterns": [
            {
              "include": "#nested"
            }
          ]
        }
      }
    }
  },
  "scopeName": "source.neo"
}
